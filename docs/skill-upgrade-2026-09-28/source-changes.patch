+// Explicit finite execution or bounded read-only attachment. No daemon or automatic retry.
+import {parseArgs} from 'node:util';
+import {runQueue,attachRun} from '../lib/execution-queue.mjs';
+import {requireValue} from '../lib/work-evidence.mjs';
+try {
+  const {values,positionals}=parseArgs({options:{root:{type:'string'},ledger:{type:'string'},task:{type:'string'},plan:{type:'string'},out:{type:'string'},'wait-ms':{type:'string'},'execute-reviewed-plan':{type:'boolean',default:false}},allowPositionals:true});
+  const [action]=positionals;
+  requireValue(positionals.length===1 && values.root && values.out,'Usage: execution-queue.mjs run|attach --root PROJECT --out NEW_RUN_DIR ...');
+  if(action==='run') {
+    requireValue(values.ledger && values.task && values.plan && values['execute-reviewed-plan'] && values['wait-ms']===undefined,'run requires --ledger REL --task ID --plan REL --execute-reviewed-plan');
+    const r=await runQueue({root:values.root,ledgerPath:values.ledger,taskId:values.task,planPath:values.plan,out:values.out,authorized:true});
+    console.log(JSON.stringify({run_id:r.run_id,status:r.status,receipt:values.out+'/run.json',task_id:r.task_id,note:'Execution result only. Review acceptance evidence before recording DONE.'},null,2));
+    if(r.status!=='SUCCEEDED')process.exitCode=2;
+  } else if(action==='attach') {
+    requireValue(!values.ledger && !values.task && !values.plan && !values['execute-reviewed-plan'],'attach is read-only; execution options are not accepted');
+    const wait=values['wait-ms']===undefined?1000:Number(values['wait-ms']);
+    requireValue(values['wait-ms']===undefined || /^\d+$/.test(values['wait-ms']),'Invalid --wait-ms');
+    const r=await attachRun({root:values.root,out:values.out,waitMs:wait});console.log(JSON.stringify(r,null,2));
+    if(['FAILED','INVALIDATED','CANCELLED','LOST'].includes(r.status))process.exitCode=2;
+  } else throw new Error('Unknown action: use run or attach');
+} catch(e) {console.error(JSON.stringify({status:'BLOCKED',error:e.message}));process.exitCode=2;}
