+#!/usr/bin/env node
+// Read-only task evidence inspection. Does not update TODOs, approve work, or schedule reminders.
+import {parseArgs} from 'node:util';
+import {readData,validateLedger,taskContract,assessLedger,mermaidProjection,requireValue} from '../lib/work-evidence.mjs';
+try {
+  const {values,positionals}=parseArgs({options:{root:{type:'string'},ledger:{type:'string'},task:{type:'string'}},allowPositionals:true});
+  const [action]=positionals;
+  requireValue(positionals.length===1 && values.root && values.ledger,'Usage: work-evidence.mjs check|due|mermaid|contract --root PROJECT --ledger RELATIVE_JSON [--task ID]');
+  const ledger=readData(values.root,values.ledger),{tasks}=validateLedger(values.root,ledger);
