+import {spawnSync} from 'node:child_process';
+import {fileURLToPath} from 'node:url';
+import {fingerprint} from '../../.opencode/lib/audit-gate.mjs';
+import {readData,validateLedger,validatePlan,taskContract,assessLedger,mermaidProjection,compareSnapshots,utc} from '../../.opencode/lib/work-evidence.mjs';
+import {runQueue,attachRun} from '../../.opencode/lib/execution-queue.mjs';
+const BASE=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../..');
+function fixture(t) {
+  const root=fs.mkdtempSync(path.join(os.tmpdir(),'studio-evidence-'));
+  t.after(()=>fs.rmSync(root,{recursive:true,force:true}));
+  const put=(name,data)=>{fs.mkdirSync(path.dirname(path.join(root,name)),{recursive:true});fs.writeFileSync(path.join(root,name),typeof data==='string'?data:JSON.stringify(data,null,2));};
+  put('value.json','{"value":42}');
+  put('check.mjs',`import assert from 'node:assert/strict';import fs from 'node:fs';assert.equal(JSON.parse(fs.readFileSync('value.json','utf8')).value,42);console.log('behavior checked');`);
+  const ledger={schema_version:1,project_root:fs.realpathSync(root),context_id:'isolated-fixture',review_policy:{interval_hours:24},goals:[{id:'G1',title:'Fixture goal'}],tasks:[{id:'T1',title:'Validate actual fixture behavior',kind:'code',status:'TODO',goal_ids:['G1'],dependencies:[],inputs:['value.json','check.mjs'],acceptance:[{id:'A1',description:'Read value is exactly 42'}],last_reviewed_at:null,next_review_at:null}]};
+  const plan={schema_version:1,max_concurrency:1,max_log_bytes:4096,jobs:[{id:'check',kind:'unit',argv:[process.execPath,'check.mjs'],cwd:'.',timeout_ms:3000,depends_on:[],covers:['A1']}]};
+  fs.mkdirSync(path.join(root,'runs'));const save=()=>{put('ledger.json',ledger);put('plan.json',plan);};save();
+  const run=out=>runQueue({root,ledgerPath:'ledger.json',taskId:'T1',planPath:'plan.json',out:out??'runs/one',authorized:true});
+  const done=(out='runs/one')=>{const task=ledger.tasks[0];task.status='DONE';task.last_reviewed_at=new Date().toISOString();task.verification={reviewer:'isolated fixture reviewer',reviewed_at:new Date().toISOString(),rationale:'Reviewed source assertion and captured check; fixture only, not installation approval.',receipt:{path:out+'/run.json',sha256:fingerprint(root,out+'/run.json')}};put('ledger.json',ledger);};
+  return {root,put,ledger,plan,save,run,done};
+}
+function assessment(f){return assessLedger(f.root,f.ledger);}
+function result(f){return assessment(f).tasks[0];}
+function editReceipt(f,edit){const r=readData(f.root,'runs/one/run.json');edit(r);f.put('runs/one/run.json',r);f.ledger.tasks[0].verification.receipt.sha256=fingerprint(f.root,'runs/one/run.json');}
+
+test('TODO check is read-only and never declares pending work complete',t=>{const f=fixture(t),before=fs.readFileSync(path.join(f.root,'ledger.json'));assert.equal(result(f).status,'TODO');assert.equal(result(f).due,true);assert.deepEqual(fs.readFileSync(path.join(f.root,'ledger.json')),before);});
