+/** Local evidence consistency checks. Not semantic proof, approval, or a scheduler. */
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+import {safeFile, fingerprint, assertRelativePath, strictRegistryJSON} from './audit-gate.mjs';
+
+const HASH = /^[a-f0-9]{64}$/;
+const ID = /^[A-Za-z][A-Za-z0-9_-]{0,63}$/;
+const STATES = new Set(['TODO', 'IN_PROGRESS', 'WAITING', 'BLOCKED', 'DONE', 'CANCELLED']);
+const JOB_KINDS = new Set(['static', 'unit', 'integration', 'runtime']);
+export const object = o => o !== null && typeof o === 'object' && !Array.isArray(o);
+export function requireValue(ok, message) { if (!ok) throw new Error(message); }
+export function nonempty(s) { return typeof s === 'string' && s.trim().length > 0 && s.length <= 8192; }
+export function canonical(value) {
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  if (object(value)) return '{' + Object.keys(value).sort().map(k=>JSON.stringify(k)+':'+canonical(value[k])).join(',') + '}';
