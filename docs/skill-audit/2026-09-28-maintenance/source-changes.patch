+def design_wip() -> str:
+    """Bounded advisory marker scan, not design completeness validation.
+
+    Preflight all candidates before returning any preview. Missing namespaces
+    are optional; unreadable/unsafe/incomplete scans block instead of claiming
+    no markers. Caps bound enumeration, total input and rendered output.
+    """
+    folder = Path.cwd().resolve()
+    for part in ('design', 'gdd'):
+        folder /= part
+        try:
+            info = folder.lstat()
+        except FileNotFoundError:
+            return '  (no local design/gdd directory; scan not applicable)\n'
+        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+            raise ValueError('design namespace must be an unlinked local directory')
+    names = []
+    with os.scandir(folder) as entries:
+        for count, entry in enumerate(entries, 1):
+            if count > 4096:
+                raise ValueError('design enumeration limit exceeded; scan incomplete')
+            if entry.name.endswith('.md'):
+                if (any(ord(ch) < 32 or 127 <= ord(ch) <= 159 for ch in entry.name)
+                        or '\\' in entry.name):
+                    raise ValueError('unsafe design filename; no content exposed')
+                names.append(entry.name)
+                if len(names) > 256:
+                    raise ValueError('design document limit exceeded; scan incomplete')
+    marker = re.compile(r'TODO|WIP|PLACEHOLDER|\[TO BE|\[TBD\]')
+    output = []
+    total_bytes = output_bytes = matches = 0
+    truncated = False
+    for name in sorted(names):
+        text = bounded_text(('design', 'gdd', name), optional=False)
+        total_bytes += len(text.encode('utf-8'))
+        if total_bytes > MAX_FILE:
+            raise ValueError('design input limit exceeded; scan incomplete')
+        for number, line in enumerate(text.splitlines(), 1):
+            if not marker.search(line):
+                continue
+            matches += 1
+            excerpt = line[:240] + (' [line truncated]' if len(line) > 240 else '')
+            rendered = f'  design/gdd/{name}:{number}: {excerpt}\n'
+            size = len(rendered.encode('utf-8'))
+            if len(output) < 100 and output_bytes + size <= 32768:
+                output.append(rendered)
+                output_bytes += size
+            else:
+                truncated = True
+    if not matches:
+        return f'  (no WIP markers in {len(names)} scanned documents; not proof of completeness)\n'
+    summary = f'  ({matches} matching lines in {len(names)} scanned documents'
+    summary += '; preview truncated' if truncated else ''
+    return ''.join(output) + summary + ')\n'
 
